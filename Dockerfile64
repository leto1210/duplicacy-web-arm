# Définir l'architecture cible (par défaut armv7)
ARG ARCH=armv8
ARG DUPLICACY_WEB_SHA256_ARM64=ff611509d8d1ea7f5382a1f2681b597a64a4d845056b164c935bfdd217320836
ARG DUPLICACY_SHA256_ARM64=9c27d8ba149e67d0bc58406c6b3218661d870cb07e265aec31563540f8f20598

# Choisir l'image Alpine en fonction de l'architecture
FROM arm64v8/alpine:3.23.4 AS base-arm64

# Utiliser l'image appropriée en fonction de $ARCH pour 64 bits
FROM base-arm64 AS builder-arm64
LABEL maintainer="leto1210"
LABEL org.label-schema.vcs-url="e.g. https://github.com/leto1210/duplicacy-web-arm"

# Définit les versions des logiciels
ENV DUPLICACY_WEB_VERSION=1.8.3 \
    DUPLICACY_VERSION=3.2.5

# Set to actual USR_ID and GRP_ID of the user this should run under
# Uses root by default, unless changed
ENV USR_ID=0 \
    GRP_ID=0

ENV TZ="Europe/Paris"

# Installer les logiciels nécessaires
RUN apk update && \
    apk add --no-cache bash ca-certificates dbus su-exec tzdata wget

ARG DUPLICACY_WEB_SHA256_ARM64
ARG DUPLICACY_SHA256_ARM64
# Télécharger et vérifier les binaires pour arm64
RUN set -e; \
    echo "Téléchargement pour arm64"; \
    if ! wget -nv -O /usr/local/bin/duplicacy_web "https://acrosync.com/duplicacy-web/duplicacy_web_linux_arm64_${DUPLICACY_WEB_VERSION}"; then \
      echo "Échec du téléchargement de duplicacy_web pour arm64" >&2; exit 1; \
    fi; \
    if ! wget -nv -O /usr/local/bin/duplicacy "https://github.com/gilbertchen/duplicacy/releases/download/v${DUPLICACY_VERSION}/duplicacy_linux_arm64_${DUPLICACY_VERSION}"; then \
      echo "Échec du téléchargement de duplicacy pour arm64" >&2; exit 1; \
    fi; \
    echo "${DUPLICACY_WEB_SHA256_ARM64}  /usr/local/bin/duplicacy_web" | sha256sum -c -; \
    echo "${DUPLICACY_SHA256_ARM64}  /usr/local/bin/duplicacy" | sha256sum -c -

RUN chmod +x /usr/local/bin/duplicacy_web /usr/local/bin/duplicacy && \
    rm -f /var/lib/dbus/machine-id && ln -s /config/machine-id /var/lib/dbus/machine-id

# Réduire la taille de l'image
RUN rm -rf /var/lib/apk/* && \
    rm -rf /tmp/* && \
    rm -rf /var/cache/apk/*

# Exposer le port et définir les volumes
EXPOSE 3875/tcp
VOLUME /config /logs /cache

# Copier les scripts d'initialisation
COPY ./init.sh ./launch.sh /usr/local/bin/

# S'assurer que les scripts sont exécutables
RUN chmod +x /usr/local/bin/init.sh /usr/local/bin/launch.sh

# Définir le point d'entrée pour arm64
ENTRYPOINT ["/usr/local/bin/init.sh"]
